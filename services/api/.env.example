# ---------------------------------------------------------------------------
# METRASIGHT — API service environment. Copy to `.env` and adjust.
# NEVER commit the real `.env`. Do not put production secrets in source control.
# ---------------------------------------------------------------------------

# Environment: development | test | production
ENVIRONMENT=development
DEBUG=true

# --- Database --------------------------------------------------------------
# Zero-config dev/test default is SQLite (no external service needed):
DATABASE_URL=sqlite:///./legalmet.db
# Production (PostgreSQL) — use docker-compose or a managed instance:
# DATABASE_URL=postgresql+psycopg2://legalmet:legalmet@localhost:5432/legalmet

# --- Security --------------------------------------------------------------
# CHANGE THIS in any non-development environment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_ALGORITHM=HS256

# --- CORS (comma-separated origins) ---------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage (S3-compatible abstraction; 'local' for dev) -----------------
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760

# --- Demo data seeding -----------------------------------------------------
# Seeds clearly-labelled DEMO users/rules on startup. DEMO ONLY — override
# these credentials and disable seeding for any real deployment.
SEED_DEMO_DATA=true
DEMO_ADMIN_EMAIL=admin@legalmet.local
DEMO_ADMIN_PASSWORD=changeme-admin
DEMO_INSPECTOR_EMAIL=inspector@legalmet.local
DEMO_INSPECTOR_PASSWORD=changeme-inspector

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# true = JSON logs (production), false = human-readable console logs (dev)
LOG_JSON=false

# --- Single-origin deployment (see docs/deployment.md) ----------------------
# Absolute path to a built web client (vite dist/). When set, the API also
# serves the SPA from its own origin. Empty = local dev (Vite serves it).
#STATIC_DIST_DIR=/srv/web
# Run the OCR-dependent demo seed + OCR prewarm in a background thread after
# the port is bound (platform deploys: never block the health check).
DEFER_HEAVY_STARTUP=false
# PaddleOCR model cache directory (defaults to ~/.paddlex). On a platform
# persistent disk, point it there so redeploys never re-download models.
#PADDLE_PDX_CACHE_HOME=/var/data/.paddlex

# --- Real perception (Prompt 4) -------------------------------------------
# OCR backend: "paddle" = real local PaddleOCR engine (requires
#   pip install "paddlepaddle==3.0.0" "paddleocr==3.1.0" "paddlex==3.1.0"
# and first-run model download to the PADDLE_PDX_CACHE_HOME); "mock" = the
# deterministic fake used by tests/demo only. See docs/ocr.md.
PERCEPTION_OCR_BACKEND=paddle
# Comma-separated OCR language codes (only configured languages are claimed).
# Default is English-only; e.g. PERCEPTION_OCR_LANGS=en,devanagari adds Hindi.
PERCEPTION_OCR_LANGS=en
# Hard timeout per image for OCR inference (seconds). Raise on very slow CPUs
# (e.g. 900 on Render Free's 0.1 CPU shared instance).
PERCEPTION_OCR_TIMEOUT_SECONDS=180
# RAM-constrained hosts (Render Free, 512 MB): set CPU threads to 1 and turn
# MKLDNN off to reduce the REAL engine's peak inference memory. Leave unset
# locally — unset means PaddleOCR's own library defaults (unchanged behaviour).
#PERCEPTION_OCR_CPU_THREADS=1
#PERCEPTION_OCR_ENABLE_MKLDNN=false
# Field candidates scoring below this (OCR confidence x pattern weight) are
# marked REVIEW_REQUIRED instead of DETECTED.
PERCEPTION_FIELD_REVIEW_THRESHOLD=0.6
# Preprocessor bounds: images are resized so the long edge stays in this range
# before OCR/vision inference.
PERCEPTION_OCR_MIN_LONG_EDGE=1000
PERCEPTION_OCR_MAX_LONG_EDGE=2400

# --- Regulatory intelligence (Prompt 5) --------------------------------------
# Idempotent seed of the researched Legal Metrology dataset at startup.
# Distinct from SEED_DEMO_DATA: this is real (research-grade, UNVERIFIED)
# content with full provenance — not fiction. Set false to manage the
# regulatory layer purely via import/API.
SEED_REGULATORY_DATA=true

# --- Deterministic compliance engine (Prompt 6) ------------------------------
# Idempotent seed of the deterministic rule configurations bound to the real
# (non-demo) Prompt 5 requirements at startup. The rules encode HOW to check
# each requirement (rule type + configuration); the requirement data itself is
# the source of truth. Set false to manage rule bindings purely via the API.
SEED_COMPLIANCE_RULES=true
